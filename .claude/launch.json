{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "v2-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "TEAJIA_API_PROXY=https://api.teajia.com VITE_API_URL=http://localhost:7811 npx vite --port 7811 --strictPort"
      ],
      "port": 7811
    },
    {
      "name": "sandbox",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "sandbox"
      ],
      "port": 7777
    },
    {
      "name": "sandbox-offline",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "sandbox:offline"
      ],
      "port": 7777
    },
    {
      "name": "vite-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 7777
    },
    {
      "name": "wrangler-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "v2-sandbox-api",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd worker && node sandbox/check-db.mjs && npx wrangler dev --port 8797"
      ],
      "port": 8797
    },
    {
      "name": "v2-sandbox-site",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "TEAJIA_API_PROXY=http://localhost:8797 VITE_API_URL= npx vite --port 7812 --strictPort"
      ],
      "port": 7812
    },
    {
      "name": "sandbox-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "sandbox:site:alt"
      ],
      "port": 7788
    }
  ]
}
