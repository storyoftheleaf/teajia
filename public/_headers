/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self)
  X-XSS-Protection: 1; mode=block
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; script-src-elem 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https://media.teajia.co https://res.cloudinary.com https://img.youtube.com https://www.youtube.com https://www.instagram.com data: blob:; media-src 'self' https://media.teajia.co https://res.cloudinary.com blob:; connect-src 'self' https://media.teajia.co https://api.cloudinary.com https://api.exchangerate-api.com https://v6.exchangerate-api.com https://api.exchangerate.host https://open.er-api.com https://cloudflareinsights.com; frame-src https://accounts.google.com https://www.youtube.com https://open.spotify.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/admin/*
  X-Robots-Tag: noindex

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/version.json
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Verification codes are one-time security responses. Pages and the service
# worker must always send these requests to the API and never retain them.
/api/verify/request
  Cache-Control: no-store

/api/verify/confirm
  Cache-Control: no-store
