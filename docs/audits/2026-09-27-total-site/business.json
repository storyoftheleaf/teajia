  "findings": [
    {
      "id": "BIZ-01",
      "severity": "P1",
      "confidence": "high",
      "title": "Admin product adapter collapses inherited freight and explicit zero values",
      "evidence": [
        "src/admin/hooks/useAdminData.ts:49",
        "src/admin/hooks/useAdminData.ts:65-66",
        "src/admin/components/inventory/InventoryRow.tsx:273-289",
        "src/admin/components/ProductEditPanel.tsx:1156-1166",
        "src/admin/components/InventoryView.tsx:1252-1255",
        "worker/src/index.ts:2520-2554"
      ],
      "impact": "Inherited freight is shown as a pinned free rate and copied as zero; deliberate zero retail override and zero stock threshold disappear in admin.",
      "reproduction": "Feed useProducts a Worker row with shipping_rate_per_kg null, fixed_retail_price_usd 0, low_stock_threshold 0.",
      "remedy": "Preserve null versus zero in the product adapter and add focused adapter cases.",
      "size": "small"
    },
    {
      "id": "BIZ-02",
      "severity": "P1",
      "confidence": "high",
      "title": "Stale order lines can overwrite a different pending order",
      "evidence": [
        "src/admin/components/EditOrderModal.tsx:53-77",
        "src/admin/components/EditOrderModal.tsx:107-127",
        "src/admin/components/OrdersView.tsx:1167-1172",
        "worker/src/index.ts:6259-6309"
      ],
      "impact": "A pending order can have its lines, prices, and stock reservations replaced by another order’s lines.",
      "reproduction": "Load A, close, open B and fail B getItems; or let A response arrive after B opens. Save B.",
      "remedy": "Clear lines before loading, ignore stale responses, and block save after load error.",
      "size": "small-medium"
    },
    {
      "id": "BIZ-03",
      "severity": "P1",
      "confidence": "high",
      "title": "Save plus Share can create duplicate invoices after PDF/share failure",
      "evidence": [
        "src/admin/components/QuickInvoiceModal.tsx:419-457",
        "worker/src/index.ts:5199-5275"
      ],
      "impact": "A saved invoice is described as failed; retry creates a second numbered invoice.",
      "reproduction": "Let invoice create succeed, then reject generatePdf or navigator.share; click Save plus Share again.",
      "remedy": "Commit UI success after invoice create; retry sharing separately without another create.",
      "size": "small-medium"
    },
    {
      "id": "BIZ-04",
      "severity": "P1",
      "confidence": "high",
      "title": "Unscoped persisted query keys can show prior-store financial and event data",
      "evidence": [
        "src/admin/components/ActivityView.tsx:29-36",
        "src/admin/components/PendingView.tsx:25-34",
        "src/admin/hooks/useEventData.ts:155-161",
        "src/admin/views/VendorProfileView.tsx:95-100",
        "src/admin/components/AccountSwitcher.tsx:75-80",
        "src/index.tsx:24-27",
        "src/index.tsx:43-68"
      ],
      "impact": "Prior-store pending orders and attendee data remain visible after an account switch while refetching or after failure; sensitive cache can survive logout on disk.",
      "reproduction": "Load pending data in A, switch to B, delay or fail B request, open Pending tab.",
      "remedy": "Key private queries by account and user, gate display by token scope, and exclude or purge sensitive persisted data.",
      "size": "medium"
    },
    {
      "id": "BIZ-05",
      "severity": "P2",
      "confidence": "high",
      "title": "Product story route casts raw Worker rows to camelCase Product and crashes",
      "evidence": [
        "src/admin/views/ProductStoryView.tsx:244-250",
        "src/admin/views/ProductStoryView.tsx:613",
        "src/lib/api.ts:1742-1745",
        "worker/src/index.ts:2520-2554"
      ],
      "impact": "Opening a product story fails when pricePerGramUSD.toFixed is called on undefined.",
      "reproduction": "Open /admin/products/:id/story for any product returned by GET /api/products.",
      "remedy": "Reuse the shared admin product adapter and route-test a raw Worker response.",
      "size": "small-medium"
    },
    {
      "id": "BIZ-06",
      "severity": "P2",
      "confidence": "high",
      "title": "Vendor profile displays zero economics and matches sales as purchases",
      "evidence": [
        "worker/src/index.ts:9027-9040",
        "src/admin/views/VendorProfileView.tsx:88-127",
        "src/admin/views/VendorProfileView.tsx:293-330",
        "worker/src/index.ts:20235-20262"
      ],
      "impact": "Vendor names, stock value, cost totals, and purchase history are false or missing.",
      "reproduction": "Open an existing vendor with products and a purchase order; compare raw endpoint fields and profile.",
      "remedy": "Define a vendor product DTO/adapter and read purchase orders or receipts by vendor identity.",
      "size": "medium"
    },
    {
      "id": "BIZ-07",
      "severity": "P2",
      "confidence": "high",
      "title": "Failed partner listing writes cannot be retried unchanged",
      "evidence": [
        "src/admin/views/PartnerListingEdit.tsx:425-467",
        "worker/src/index.ts:24715-24725"
      ],
      "impact": "Stock, price, sample, or note edits that fail remain locally marked saved and are skipped on retry.",
      "reproduction": "Reject updateListing; blur the same unchanged field again.",
      "remedy": "Advance lastSaved only after success and keep a retryable dirty state on failure.",
      "size": "small"
    },
    {
      "id": "BIZ-08",
      "severity": "P2",
      "confidence": "high",
      "title": "Admin uploads and MCP tokens page ignore sessionStorage token fallback",
      "evidence": [
        "src/lib/api.ts:596-618",
        "src/lib/api.ts:2454-2465",
        "src/lib/api.ts:2488-2497",
        "src/admin/views/MCPTokensView.tsx:52-58",
        "worker/src/index.ts:12697-12700",
        "worker/src/index.ts:12911-12914"
      ],
      "impact": "A fallback authenticated session cannot upload event flyers or venue photos or manage MCP tokens.",
      "reproduction": "Block localStorage writes, sign in so token is stored in sessionStorage, then invoke those actions.",
      "remedy": "Use the shared authenticated request/header path.",
      "size": "small"
    }
  ],
