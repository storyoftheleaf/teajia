{
  "name": "teajia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "lsof -ti:7777 >/dev/null 2>&1 || (infisical export --env=dev --format=dotenv --path=/ > .env.local && vite)",
    "claude": "infisical run --env=dev --path=/ -- claude",
    "mcp:check": "infisical run --env=dev --path=/ -- node scripts/check-mcp-token.mjs",
    "mcp:call": "infisical run --env=dev --path=/ -- node scripts/mcp-call.mjs",
    "dev:test": "VITE_API_URL=http://localhost:7777 vite",
    "sandbox": "concurrently -n api,site -c magenta,cyan \"npm --prefix worker run sandbox\" \"npm run sandbox:site\"",
    "sandbox:site": "VITE_API_URL=http://localhost:8787 vite --port 7777",
    "sandbox:offline": "concurrently -n api,site -c magenta,cyan \"npm --prefix worker run sandbox:offline\" \"npm run sandbox:site\"",
    "sandbox:refresh": "npm --prefix worker run sandbox:refresh",
    "sandbox:seed-creators": "npm --prefix worker run sandbox:seed-creators",
    "build": "node scripts/check-required-deployment-config.mjs --if-cloudflare-pages && vite build",
    "check:deploy-config": "node scripts/check-required-deployment-config.mjs",
    "lint:colors": "bash scripts/lint-colors.sh",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test:src": "vitest run src --exclude='**/*.behavior.test.ts' --exclude='**/.claude/worktrees/**' --exclude='**/.worktrees/**'",
    "lint:worker-types": "node scripts/worker-typecheck-ratchet.mjs",
    "audit": "node scripts/audit.mjs",
    "audit:shop-catalogue": "node scripts/audit-shop-catalogue.mjs",
    "intake:findings": "node scripts/intake-findings.mjs",
    "incidents:export": "node scripts/export-incident-queue.mjs",
    "test:worker": "NODE_OPTIONS=--experimental-sqlite vitest run worker/tests --exclude='**/.claude/worktrees/**' --exclude='**/.worktrees/**' --testTimeout=20000",
    "test:china-scan": "node --test scripts/check-china-dependencies.test.mjs",
    "audit:china": "node scripts/check-china-dependencies.mjs .",
    "test:recovery": "playwright test --config=playwright.recovery.config.ts",
    "test:mobile": "playwright test tests/account-panel-mobile.spec.ts tests/customer-money-mobile.spec.ts --project='Mobile Chrome' --reporter=list",
    "test:platform-hardening": "node --test scripts/platform-hardening.test.mjs",
    "test:mcp-token": "node --test scripts/check-mcp-token.test.mjs",
    "test:tea-reference-capture": "node --test scripts/tea-reference-capture/tests/*.test.mjs",
    "test:tea-reference-pages": "node --test scripts/tea-reference-markdown/tests/*.test.mjs",
    "test:tea-reference-receiving": "vitest run src/pages/wisdom/reference.test.tsx src/wisdom/reference/catalogue.test.ts src/wisdom/receiving/previewImporter.test.ts && vitest run --mode tea-reference-preview src/pages/wisdom/reference.test.tsx src/wisdom/reference/catalogue.test.ts && node --test scripts/tea-reference-capture/tests/adapters.test.mjs scripts/tea-reference-website-preview/tests/*.test.mjs",
    "test:tea-reference-browser": "playwright test --config=playwright.tea-reference.config.ts",
    "test:tea-reference-revision-browser": "playwright test --config=playwright.tea-reference-revision.config.ts",
    "tea-reference:capture:preview": "node scripts/tea-reference-capture/cli.mjs --allowlist scripts/tea-reference-capture/pilot-allowlist.json --output outputs/tea-reference-capture/pilot",
    "tea-reference:capture:diversity-preview": "node scripts/tea-reference-capture/cli.mjs --allowlist scripts/tea-reference-capture/source-diversity-allowlist.json --output outputs/tea-reference-capture/source-diversity",
    "tea-reference:pages": "node scripts/tea-reference-markdown/build-pages.mjs",
    "tea-reference:pages:check": "node scripts/tea-reference-markdown/build-pages.mjs --check",
    "tea-reference:website:preview": "node scripts/tea-reference-website-preview/preview-cli.mjs",
    "tea-reference:teajia:preview": "node scripts/tea-reference-website-preview/teajia-preview.mjs",
    "sandbox:site:alt": "TEAJIA_API_PROXY=http://localhost:8787 VITE_API_URL=http://localhost:7788 vite --port 7788"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@react-pdf/renderer": "^3.1.14",
    "@tanstack/query-sync-storage-persister": "^5.100.5",
    "@tanstack/react-query": "^5.17.0",
    "@tanstack/react-query-persist-client": "^5.100.5",
    "cmdk": "^1.1.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "framer-motion": "^12.34.3",
    "fuse.js": "^7.0.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.554.0",
    "papaparse": "^5.4.1",
    "qrcode.react": "^3.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^5.5.7",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^2.12.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "terser": "^5.44.1",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.5"
  }
}
