# Copy this file to .env.local and fill in your values

# Teajia API Worker URL (required)
VITE_API_URL=https://teajia-api.lightcodes.workers.dev

# Exchange Rate API Key (optional)
VITE_EXCHANGE_RATE_API_KEY=

# WhatsApp Business Number (for order inquiries, include country code)
VITE_WHATSAPP_NUMBER=

# Cloudinary cloud name (for image optimization & hosting)
VITE_CLOUDINARY_CLOUD_NAME=
